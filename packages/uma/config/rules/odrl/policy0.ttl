@prefix ex: <http://example.org/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

ex:spo2Policy a odrl:Agreement ;
  odrl:uid ex:spo2Policy ;
  odrl:permission
    ex:createSpo2ContainerAlice,
    ex:createSpo2ContainerBobBenchmark,
    ex:spo2AliceAccess,
    ex:spo2BobBenchmarkAccess,
    ex:spo2PandaBenchmarkAccess,
    ex:spo2ReplayerBenchmarkAccess,
    ex:derivedSpo2AliceAccess,
    ex:derivedSpo2BobBenchmarkAccess,
    ex:derivedSpo2PandaBenchmarkAccess,
    ex:derivedSpo2ReplayerBenchmarkAccess,
    ex:spo2DerivedAliceAccess,
    ex:spo2DerivedBobBenchmarkAccess,
    ex:aliceDerivedLatestAliceRead,
    ex:aliceDerivedLatestBobBenchmarkRead,
    ex:aliceDerivedContainerAliceAccess,
    ex:aliceDerivedContainerBobBenchmarkRead,
    ex:aliceDerivedContainerMetaAliceAccess,
    ex:derivedContainerAliceAccess,
    ex:derivedContainerBobBenchmarkAccess,
    ex:webhookChannelBobBenchmarkAccess .

ex:createSpo2ContainerAlice a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:createSpo2ContainerBobBenchmark a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> ;
  odrl:constraint [
    a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <urn:client:benchmark>
  ] .

ex:spo2AliceAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append, odrl:write ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2BobBenchmarkAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append ;
