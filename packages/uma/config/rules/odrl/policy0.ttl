@prefix ex: <http://example.org/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

ex:spo2Policy a odrl:Agreement ;
  odrl:uid ex:spo2Policy ;
  odrl:permission
    ex:createSpo2ContainerAliceBob,
    ex:spo2AliceAccess,
    ex:spo2BobPandaAccess,
    ex:spo2ReplayerAccess,
    ex:derivedSpo2AliceBobPandaAccess,
    ex:derivedSpo2ReplayerAccess,
    ex:spo2DerivedAliceBobAccess,
    ex:aliceDerivedLatestAliceBobRead,
    ex:aliceDerivedContainerAliceAccess,
    ex:aliceDerivedContainerBobRead,
    ex:aliceDerivedContainerMetaAliceAccess,
    ex:derivedContainerAliceBobAccess,
    ex:webhookChannelBobAccess .

ex:createSpo2ContainerAliceBob a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/> ;
  odrl:assignee
    <http://localhost:3000/alice/profile/card#me>,
    <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2AliceAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append, odrl:write ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2BobPandaAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee
    <http://localhost:3000/bob/profile/card#me>,
    <http://localhost:8080/panda#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2ReplayerAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee <http://n063-04b.wall2.ilabt.iminds.be/replayer#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:derivedSpo2AliceBobPandaAccess a odrl:Permission ;
  odrl:action odrl:create, odrl:read, odrl:append ;
  odrl:target <http://localhost:3000/alice/derived/spo2/> ;
  odrl:assignee
    <http://localhost:3000/alice/profile/card#me>,
    <http://localhost:3000/bob/profile/card#me>,
    <http://localhost:8080/panda#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:derivedSpo2ReplayerAccess a odrl:Permission ;
  odrl:action odrl:read ;
  odrl:target <http://localhost:3000/alice/derived/spo2/> ;
  odrl:assignee <http://n063-04b.wall2.ilabt.iminds.be/replayer#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2DerivedAliceBobAccess a odrl:Permission ;
  odrl:action odrl:read, odrl:append ;
  odrl:target <http://localhost:3000/alice/spo2/derived> ;
  odrl:assignee
    <http://localhost:3000/alice/profile/card#me>,
    <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:aliceDerivedLatestAliceBobRead a odrl:Permission ;
  odrl:action odrl:read ;
  odrl:target <http://localhost:3000/alice/derived/latest> ;
  odrl:assignee
    <http://localhost:3000/alice/profile/card#me>,
    <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:aliceDerivedContainerAliceAccess a odrl:Permission ;
  odrl:action odrl:read, odrl:append, odrl:write ;
  odrl:target <http://localhost:3000/alice/derived/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:aliceDerivedContainerBobRead a odrl:Permission ;
  odrl:action odrl:read ;
  odrl:target <http://localhost:3000/alice/derived/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:aliceDerivedContainerMetaAliceAccess a odrl:Permission ;
  odrl:action odrl:append, odrl:write ;
  odrl:target <http://localhost:3000/alice/derived/.meta> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:derivedContainerAliceBobAccess a odrl:Permission ;
  odrl:action odrl:read, odrl:append ;
  odrl:target <http://localhost:3000/derived> ;
  odrl:assignee
    <http://localhost:3000/alice/profile/card#me>,
    <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:webhookChannelBobAccess a odrl:Permission ;
  odrl:action odrl:read, odrl:append, odrl:create ;
  odrl:target <http://localhost:3000/.notifications/WebhookChannel2023/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .