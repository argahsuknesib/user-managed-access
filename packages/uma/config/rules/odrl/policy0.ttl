@prefix ex: <http://example.org/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

ex:spo2Policy a odrl:Agreement ;
  odrl:uid ex:spo2Policy ;
  odrl:permission
    ex:aliceCreateSpo2ContainerAlice,
    ex:aliceCreateSpo2ContainerBob,
    ex:spo2ReadAlice,
    ex:spo2ReadBob,
    ex:spo2ReadPanda,
    ex:spo2ReadReplayer,
    ex:spo2CreatePanda,
    ex:spo2CreateReplayer,
    ex:spo2AppendPanda,
    ex:spo2AppendReplayer,
    ex:spo2CreateAlice,
    ex:spo2CreateBob,
    ex:spo2WriteAlice,
    ex:spo2AppendAlice,
    ex:spo2AppendBob,
    ex:derivedSpo2ReadAlice,
    ex:derivedSpo2ReadBob,
    ex:derivedSpo2ReadPanda,
    ex:derivedSpo2ReadReplayer,
    ex:derivedSpo2CreateAlice,
    ex:derivedSpo2CreateBob,
    ex:derivedSpo2CreatePanda,
    ex:derivedSpo2AppendAlice,
    ex:derivedSpo2AppendBob,
    ex:derivedSpo2AppendPanda,
    ex:spo2DerivedReadAlice,
    ex:spo2DerivedReadBob,
    ex:spo2DerivedAppendAlice,
    ex:spo2DerivedAppendBob,
    ex:aliceDerivedLatestReadAlice,
    ex:aliceDerivedLatestReadBob,
    ex:aliceDerivedContainerReadAlice,
    ex:aliceDerivedContainerReadBob,
    ex:aliceDerivedContainerAppendAlice,
    ex:aliceDerivedContainerWriteAlice,
    ex:derivedContainerReadAlice,
    ex:derivedContainerReadBob,
    ex:derivedContainerAppendAlice,
    ex:derivedContainerAppendBob,
    ex:webhookChannelReadBob,
    ex:webhookChannelAppendBob,
    ex:webhookChannelCreateBob .

# Container creation is authorized on /alice/ because creating /alice/spo2/
# is evaluated by UMA as "create in parent container".
ex:aliceCreateSpo2ContainerAlice a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:aliceCreateSpo2ContainerBob a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2CreateAlice a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee <http://localhost:3000/alice/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2CreateBob a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/alice/spo2/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

