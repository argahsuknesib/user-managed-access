ex:alertWritePolicy odrl:uid ex:alertWritePolicy .
ex:alertWritePolicy odrl:permission ex:alertWritePermission .
ex:alertWritePermission a odrl:Permission .
ex:alertWritePermission odrl:action odrl:write, odrl:append, odrl:create, odrl:modify .
ex:alertWritePermission odrl:target <http://localhost:3000/alice/derived/anomaly-alert/> .
ex:alertWritePermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:alertWritePermission odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:alertReadPolicy a odrl:Agreement .
ex:alertReadPolicy odrl:uid ex:alertReadPolicy .
ex:alertReadPolicy odrl:permission ex:alertReadPermission .
ex:alertReadPermission a odrl:Permission .
ex:alertReadPermission odrl:action odrl:read .
ex:alertReadPermission odrl:target <http://localhost:3000/alice/derived/anomaly-alert/> .
ex:alertReadPermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:alertReadPermission odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2ReadPolicy a odrl:Agreement .
ex:spo2ReadPolicy odrl:uid ex:spo2ReadPolicy .
