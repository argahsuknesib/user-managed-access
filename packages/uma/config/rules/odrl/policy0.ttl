ex:spo2WritePolicy odrl:uid ex:spo2WritePolicy .
ex:spo2WritePolicy odrl:permission ex:spo2WritePermission .
ex:spo2WritePermission a odrl:Permission .
ex:spo2WritePermission odrl:action odrl:write, odrl:append, odrl:create, odrl:modify .
ex:spo2WritePermission odrl:target <http://localhost:3000/alice/spo2/> .
