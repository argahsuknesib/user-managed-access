# PANDA uses Bob's WebID claim by default (see PANDA/src/config/UmaClaim.ts).
# These permissions allow PANDA to register webhook subscriptions.
ex:webhookChannelReadBob a odrl:Permission ;
  odrl:action odrl:read ;
  odrl:target <http://localhost:3000/.notifications/WebhookChannel2023/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:webhookChannelAppendBob a odrl:Permission ;
  odrl:action odrl:append ;
  odrl:target <http://localhost:3000/.notifications/WebhookChannel2023/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:webhookChannelCreateBob a odrl:Permission ;
  odrl:action odrl:create ;
  odrl:target <http://localhost:3000/.notifications/WebhookChannel2023/> ;
  odrl:assignee <http://localhost:3000/bob/profile/card#me> ;
  odrl:assigner <http://localhost:3000/alice/profile/card#me> .
