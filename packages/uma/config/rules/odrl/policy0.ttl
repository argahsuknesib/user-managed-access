@prefix ex: <http://example.org/>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

ex:accXReadPolicy a odrl:Agreement .
ex:accXReadPolicy odrl:uid ex:accXReadPolicy .
ex:accXReadPolicy odrl:permission ex:accXReadPermission .
ex:accXReadPermission a odrl:Permission .
ex:accXReadPermission odrl:action odrl:read .
ex:accXReadPermission odrl:target <http://localhost:3000/alice/acc-x/> .
ex:accXReadPermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:accXReadPermission odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:accXWritePolicy a odrl:Agreement .
ex:accXWritePolicy odrl:uid ex:accXWritePolicy .
ex:accXWritePolicy odrl:permission ex:accXWritePermission .
ex:accXWritePermission a odrl:Permission .
ex:accXWritePermission odrl:action odrl:write, odrl:append, odrl:create, odrl:modify .
ex:accXWritePermission odrl:target <http://localhost:3000/alice/acc-x/> .
ex:accXWritePermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:accXWritePermission odrl:assigner <http://localhost:3000/alice/profile/card#me> .

