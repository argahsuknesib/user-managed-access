@prefix ex: <http://example.org/>.
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

ex:spo2ReadPolicy a odrl:Agreement .
ex:spo2ReadPolicy odrl:uid ex:spo2ReadPolicy .
ex:spo2ReadPolicy odrl:permission ex:spo2ReadPermission .
ex:spo2ReadPermission a odrl:Permission .
ex:spo2ReadPermission odrl:action odrl:read .
ex:spo2ReadPermission odrl:target <http://localhost:3000/alice/spo2/> .
ex:spo2ReadPermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:spo2ReadPermission odrl:assigner <http://localhost:3000/alice/profile/card#me> .

ex:spo2WritePolicy a odrl:Agreement .
ex:spo2WritePolicy odrl:uid ex:spo2WritePolicy .
ex:spo2WritePolicy odrl:permission ex:spo2WritePermission .
ex:spo2WritePermission a odrl:Permission .
ex:spo2WritePermission odrl:action odrl:write, odrl:append, odrl:create, odrl:modify .
ex:spo2WritePermission odrl:target <http://localhost:3000/alice/spo2/> .
ex:spo2WritePermission odrl:assignee <http://localhost:3000/bob/profile/card#me> .
ex:spo2WritePolicy odrl:assigner <http://localhost:3000/alice/profile/card#me> .
